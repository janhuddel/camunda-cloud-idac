# Connection config for @camunda8/orchestration-cluster-api.
# createCamundaResultClient() reads these directly - the CLI takes no separate
# --cluster-url/--client-id flags on purpose (see README).
#
# REST API base address of the orchestration cluster.
CAMUNDA_REST_ADDRESS=https://<cluster-id>.<region>.zeebe.camunda.io/<cluster-id>

# OAuth client credentials for an M2M client with admin authorizations
# (must itself be authorized to manage roles/groups/tenants/mappingRules/authorizations).
CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=

# Optional: defaults to "<default>" - the literal system tenant id. Only override
# if your cluster's default tenant assignment differs.
# CAMUNDA_DEFAULT_TENANT_ID=<default>

# Optional mTLS (self-managed only):
# CAMUNDA_MTLS_CERT_CHAIN=
# CAMUNDA_MTLS_PRIVATE_KEY=
# CAMUNDA_MTLS_CA=
